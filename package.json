{
  "name": "faq-chatbot",
  "version": "1.0.0",
  "description": "HR FAQ Chatbot System with Employee Chat and HR Admin Dashboard",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "nodemon --watch server.js server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "start": "node server.js",
    "test": "node test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "vite": "^5.2.11",
    "nodemon": "^3.1.0",
    "concurrently": "^8.2.2"
  }
}
